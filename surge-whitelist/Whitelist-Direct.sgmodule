#!name=瞬影白名单
#!desc=v1.1.0 瞬影播放链路直连白名单: 服务器 yd.emby.syemby.com 与其 302 媒体流走的 139 接口 (139.com) 和移动云盘对象存储 (cmecloud.cn) 全部强制 DIRECT, 不走代理节点 (瞬影PRO只认中国大陆 IP)。本模块只含下面三条规则, 无其他段落; Surge 模块规则会插入主配置规则列表最前面, 优先于主配置生效。
#!system=ios
#!version=1.1.0
#!author=Muse
#!category=直连白名单

[Rule]
DOMAIN-SUFFIX,yd.emby.syemby.com,DIRECT
DOMAIN-SUFFIX,cmecloud.cn,DIRECT
DOMAIN-SUFFIX,139.com,DIRECT

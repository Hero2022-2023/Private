#!name=瞬影PRO直连白名单
#!desc=v1.0.1 只针对瞬影PRO线路 yd.emby.syemby.com 一个域名, 与其他模块无关: 把它的流量强制直连, 不走任何代理节点 (PRO 服只认中国大陆 IP, 走节点出口会被拒, 多地异地 IP 还可能封号)。三层一起: 规则 DIRECT (模块规则优先于主配置), skip-proxy 与 always-real-ip 追加 (拿真实 IP), MITM 排除该域名。本模块不带 compatibility-mode, 不改 Surge 的接管方式。
#!system=ios
#!version=1.0.1
#!author=Muse
#!category=直连白名单

[General]
skip-proxy = %APPEND% yd.emby.syemby.com, *.yd.emby.syemby.com
always-real-ip = %APPEND% yd.emby.syemby.com, *.yd.emby.syemby.com

[Rule]
DOMAIN-SUFFIX,yd.emby.syemby.com,DIRECT

[MITM]
hostname = %APPEND% -yd.emby.syemby.com, -*.yd.emby.syemby.com

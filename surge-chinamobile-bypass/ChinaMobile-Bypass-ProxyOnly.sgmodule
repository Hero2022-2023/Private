#!name=中国移动直连绕过 (仅代理版)
#!desc=v1.1.0 2026-11-12 真机验证: 本模块启用后中国移动 App 在 Surge 开启下可正常打开 (模式 5 实测无效)。原理: compatibility-mode=2 仅代理接管, VIF 不再接管任何流量, App 查的正是 VIF 接管这件事; 同时 chinamobile.com / 10086.cn / cmpassport.com / 139.com 全走 DIRECT + 真实 IP + MITM 排除。注意这是全局工作模式: 不遵循系统代理的 App 不会被 Surge 接管 (流量直走物理网络, 不经节点), 切换/启用后必须彻底停止再启动 Surge 才生效。本模块启用时不要再启用主模块 (模式 5 那个)。Surge 的 VPN 描述文件仍连接、状态栏 VPN 图标仍在, 属正常。
#!system=ios
#!version=1.1.0
#!author=Muse
#!category=直连绕过

[General]
compatibility-mode = 2
skip-proxy = %APPEND% *.chinamobile.com, *.10086.cn, *.cmpassport.com, *.139.com
always-real-ip = %APPEND% *.chinamobile.com, *.10086.cn, *.cmpassport.com, *.139.com

[Rule]
DOMAIN-SUFFIX,chinamobile.com,DIRECT
DOMAIN-SUFFIX,10086.cn,DIRECT
DOMAIN-SUFFIX,cmpassport.com,DIRECT
DOMAIN-SUFFIX,139.com,DIRECT

[MITM]
hostname = %APPEND% -*.chinamobile.com, -*.10086.cn, -*.cmpassport.com, -*.139.com

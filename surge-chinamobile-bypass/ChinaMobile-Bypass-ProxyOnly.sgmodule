#!name=中国移动直连绕过 (仅代理版)
#!desc=v1.1.1 此前标注的「模式 2 实测有效」源于用户误点选项, 已撤回; 用户实际反馈是用更新后的模块仍无法打开。compatibility-mode 写在模块里是否真能切换 Surge 工作模式尚不确定, 决定性复核请改用同目录的 Test-Mode2.conf 测试配置 (模式直接写在配置 [General] 里, 停用全部模块后切换该配置测试)。本模块内容: compatibility-mode=2 仅代理接管 + chinamobile.com / 10086.cn / cmpassport.com / 139.com 全走 DIRECT + 真实 IP + MITM 排除。启用后必须彻底停止再启动 Surge。
#!system=ios
#!version=1.1.1
#!author=Muse
#!category=直连绕过

[General]
compatibility-mode = 2
skip-proxy = %APPEND% *.chinamobile.com, *.10086.cn, *.cmpassport.com, *.139.com
always-real-ip = %APPEND% *.chinamobile.com, *.10086.cn, *.cmpassport.com, *.139.com

[Rule]
DOMAIN-SUFFIX,chinamobile.com,DIRECT
DOMAIN-SUFFIX,10086.cn,DIRECT
DOMAIN-SUFFIX,cmpassport.com,DIRECT
DOMAIN-SUFFIX,139.com,DIRECT

[MITM]
hostname = %APPEND% -*.chinamobile.com, -*.10086.cn, -*.cmpassport.com, -*.139.com
